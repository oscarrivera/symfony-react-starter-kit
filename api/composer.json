{
    "name": "oscar-rivera/parte-de-trabajo",
    "description": "API de partes de trabajo (Symfony components)",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "symfony/http-foundation": "^7.2",
        "symfony/routing": "^7.2",
        "symfony/http-kernel": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/validator": "^7.2",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        },
        "audit": {
            "ignore": {
                "PKSA-y2cr-5h3j-g3ys": "CVE-2025-45769 disputed; HS256 key length is enforced (APP_SECRET >= 32)."
            }
        }
    }
}
