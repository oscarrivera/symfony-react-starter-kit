APP_ENV=dev
# Obligatorio: mínimo 32 caracteres. Sustituir antes de cualquier despliegue.
APP_SECRET=replace-this-secret-in-production-32
JWT_TTL=900
REFRESH_TTL=604800
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=var/data.sqlite
# 0 en HTTP local. 1 en producción (HTTPS). La cookie de refresh se emite siempre HttpOnly + SameSite=Strict.
COOKIE_SECURE=0
